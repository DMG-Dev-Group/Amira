      "name": "3. POST /api/webhook-mp",
      "item": [
        {
          "name": "Sem assinatura — 401 (se MP_WEBHOOK_SECRET estiver configurado na Vercel)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "// Se MP_WEBHOOK_SECRET NAO estiver configurado na Vercel, o codigo aceita",
            "// mesmo assim (so avisa no log) e aqui vai vir 200, nao 401. Os dois sao",
            "// 'corretos' dependendo do estado da env var — o importante e SABER qual.",
            "pm.test('401 (segredo configurado) ou 200 (segredo ausente)', function () {",
            "  pm.expect([401, 200]).to.include(pm.response.code);",
            "});",
            "if (pm.response.code === 200) console.warn('MP_WEBHOOK_SECRET pode nao estar configurado na Vercel — confira /api/status.');"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"payment\",\n  \"data\": { \"id\": \"123456789\" }\n}" },
            "url": "{{base_url}}/api/webhook-mp"
