            "  console.log('Node na Vercel:', j.node, '| prefixo do token MP:', j.env.MP_ACCESS_TOKEN_prefixo);",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{id_token_admin}}" }],
            "url": "{{base_url}}/api/status"
          }
        },
        {
          "name": "Sem token — 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 sem autenticacao', function () { pm.response.to.have.status(401); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/status"
          }
        },
        {
          "name": "Cliente comum — 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 nao-admin', function () { pm.response.to.have.status(403); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{id_token}}" }],
            "url": "{{base_url}}/api/status"
          }
        }
      ]
    },
    {
      "name": "6. Rate limit (opcional — consome a cota real)",
      "item": [
        {
          "name": "Estourar limite de /api/pagamento (rode 11x pelo Runner)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "// Rode esta requisicao 11 vezes seguidas (Collection Runner, 11 iteracoes,",
            "// 0ms de delay) dentro da MESMA janela de 5 minutos. As 10 primeiras devem",
            "// dar 200 (ou 409 se o pedido ja tiver sido pago no meio do caminho —",
            "// tambem conta como 'nao foi limitado'); a 11a tem que dar 429.",
            "pm.test('200, 409 ou 429 — nunca outra coisa', function () {",
            "  pm.expect([200, 409, 429]).to.include(pm.response.code);",
            "});",
            "if (pm.response.code === 429) {",
            "  console.log('Rate limit funcionou. retryApos:', pm.response.json().erro);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{id_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pedidoId\": \"{{pedido_id}}\"\n}" },
            "url": "{{base_url}}/api/pagamento",
            "description": "Limite documentado: 10 chamadas / 5 min por uid. So teste isso se souber que vai usar de proposito — cria ate 10 preferencias reais no Mercado Pago."
          }
        }
      ]
    }
  ]
