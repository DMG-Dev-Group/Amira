          }
        },
        {
          "name": "Reconciliacao com admin — 200 ou 404",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 (achou pagamento) ou 404 (pedido sem pagamento associado)', function () {",
            "  pm.expect([200, 404]).to.include(pm.response.code);",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{id_token_admin}}" }],
            "url": "{{base_url}}/api/webhook-mp?pedidoId={{pedido_id}}"
          }
        },
        {
          "name": "[Opcional] Assinatura valida — precisa de mp_webhook_secret",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Reproduz EXATAMENTE o checarAssinatura() de api/webhook-mp.js.",
                  "// mp_webhook_secret e o MESMO valor de MP_WEBHOOK_SECRET na Vercel —",
                  "// so preencha no Environment se quiser este teste; NUNCA versione com valor real.",
                  "const secret = pm.environment.get('mp_webhook_secret');",
                  "if (!secret) { console.warn('mp_webhook_secret vazio — esta chamada vai dar 401.'); }",
                  "const dataId = pm.environment.get('mp_payment_id_teste') || '123456789';",
                  "const ts = Date.now().toString();",
                  "const idNormalizado = /[a-zA-Z]/.test(dataId) ? dataId.toLowerCase() : dataId;",
                  "const manifest = `id:${idNormalizado};ts:${ts};`;",
                  "const hash = CryptoJS.HmacSHA256(manifest, secret || '').toString(CryptoJS.enc.Hex);",
                  "pm.environment.set('_mp_signature', `ts=${ts},v1=${hash}`);",
                  "pm.environment.set('_mp_data_id', dataId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 (assinatura aceita)', function () { pm.response.to.have.status(200); });",
                "console.log('Depois disso, confira no Firebase Console se pedidos/{{pedido_id}}.pagamento mudou.');"
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-signature", "value": "{{_mp_signature}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"payment\",\n  \"data\": { \"id\": \"{{_mp_data_id}}\" }\n}" },
            "url": "{{base_url}}/api/webhook-mp",
            "description": "Teste de ponta a ponta de verdade: rode 'POST /api/pix > Sucesso' primeiro (ele guarda mp_payment_id_teste sozinho), DEPOIS este. Assim o webhook consulta um pagamento PIX real no Mercado Pago em vez de um id inventado."
          }
        }
      ]
    },
