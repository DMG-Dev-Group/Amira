# ── Environment Variables das funções serverless (/api/*) ──────────────
# Copie estes nomes para o painel da Vercel:
#   Project -> Settings -> Environment Variables
# NUNCA commitar os valores reais. O arquivo .env já está no .gitignore.

# ── Mercado Pago ──────────────────────────────────────────────────────
# Painel do desenvolvedor -> Suas integrações -> (sua aplicação) ->
# Credenciais de produção / de teste.
# Comece com as credenciais de TESTE (prefixo TEST-).
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Painel -> Webhooks -> "Assinatura secreta" (usada para validar x-signature).
MP_WEBHOOK_SECRET=coloque-a-assinatura-secreta-do-webhook

# ── Firebase Admin (para as funções lerem/gravarem no Firestore) ───────
# Service account do projeto Firebase de PRODUÇÃO.
# Console Firebase -> Config. do projeto -> Contas de serviço ->
# "Gerar nova chave privada" -> cole o JSON INTEIRO aqui, numa linha só
# (com as quebras de linha da private_key como \n literais).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"SEU_PROJETO","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@SEU_PROJETO.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# ── Site ─────────────────────────────────────────────────────────────
# URL pública, usada nas back_urls e no notification_url do Mercado Pago.
# Sem barra no final.
PUBLIC_BASE_URL=https://amira-phi.vercel.app
